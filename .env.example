APP_NAME=AegisOps
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://aegisops:aegisops_local@localhost:5433/aegisops
GRAFANA_ADMIN_PASSWORD=change_me
ALERTMANAGER_WEBHOOK_TOKEN=replace_with_a_long_random_secret
PROMETHEUS_URL=http://localhost:9090

GEMINI_API_KEY=your_actual_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# Comma-separated token:identity:roles (e.g. operator+executor) or JSON mapping
HUMAN_AUTH_TOKENS=your_operator_token:sre-operator-dan:operator+executor,your_approver_token:sre-lead-charlie:approver,your_viewer_token:sre-viewer-dave:viewer

# Restrict live diagnostic operations against Prometheus (read-only, default false)
LIVE_DIAGNOSTICS_ENABLED=false