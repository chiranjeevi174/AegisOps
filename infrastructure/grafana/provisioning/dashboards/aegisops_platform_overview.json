      "id": 103,
      "title": "Platform Infrastructure & Dependency Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aegisops-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "Unhealthy" }, "1": { "color": "green", "text": "Healthy" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 28 },
      "id": 10,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [
        {
          "expr": "aegisops_dependency_health_status",
          "legendFormat": "{{dependency}}"
        }
      ],
      "title": "Core Dependency Health Status (1=Ready, 0=Unready)",
      "type": "stat"
