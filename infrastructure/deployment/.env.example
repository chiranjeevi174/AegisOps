# ==============================================================================
# AegisOps — Production-Oriented Deployment Environment Configuration
# Copy this file to .env inside infrastructure/deployment/ and configure values securely.
# ==============================================================================

# Application Environment Mode
APP_ENV=production
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# Deployment Host and Port (Single-server reverse proxy entrypoint)
HOST_IP=127.0.0.1
APP_PORT=8080

# Internal PostgreSQL Configuration (Service is isolated, not exposed to host)
POSTGRES_DB=aegisops
POSTGRES_USER=aegisops
POSTGRES_PASSWORD=replace_with_strong_production_postgres_password
DATABASE_URL=postgresql+asyncpg://aegisops:replace_with_strong_production_postgres_password@postgres:5432/aegisops

# Security Secrets & Gating
ALERTMANAGER_WEBHOOK_TOKEN=replace_with_strong_alertmanager_webhook_token
CSRF_SECRET_KEY=replace_with_cryptographically_random_csrf_secret_min_32_chars
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_admin_password

# Persona & Diagnostic Restrictions (Must remain strictly disabled outside local development)
ENABLE_DEV_PERSONA_SWITCHING=false
LIVE_DIAGNOSTICS_ENABLED=false

# Google Gemini Integration
GEMINI_API_KEY=replace_with_production_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Telemetry & Monitoring Bindings
PROMETHEUS_PORT=9091
ALERTMANAGER_PORT=9094
GRAFANA_PORT=3001

# Allowed Reverse Proxy Origins and Trusted Proxies
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
TRUSTED_PROXIES=127.0.0.1,frontend
